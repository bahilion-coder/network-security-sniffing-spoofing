#!/bin/bash
exec /usr/bin/python3 - <<'PYCODE'
import socket, time
s=socket.create_connection(('10.9.0.5',23),timeout=5)
time.sleep(0.5)
s.sendall(b'labtelnet\r\n')
time.sleep(0.5)
s.sendall(b'{{ flag_m7_telnet }}\r\n')
time.sleep(0.5)
s.close()
print('A controlled Telnet login attempt was generated.')
PYCODE
