#!/bin/bash
# Ask the user machines (client) to generate the traffic needed by a task.
#     lab-trigger list       show the available scenarios
#     lab-trigger <id>       run one scenario, e.g.  lab-trigger 1.1a
# client only accepts the scenario names listed above; nothing else can be executed there.
exec ssh -i "$HOME/.lab/id_ed25519" -o IdentitiesOnly=yes -o BatchMode=yes \
     -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
     labtrigger@10.1.26.11 "${@:-list}"
